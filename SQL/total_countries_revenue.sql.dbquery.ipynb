   "source": [
    "-- Top 6 countries by total revenue for the pie chart\n",
    "SELECT\n",
    "  Country,\n",
    "  SUM(TotalRevenue) as CountryRevenue\n",
    "FROM\n",
    "  personal_projects.information_retail_schema.gold_monthly_revenue_by_country\n",
    "GROUP BY\n",
    "  Country\n",
    "ORDER BY\n",
    "  CountryRevenue DESC\n",
    "LIMIT 6"
   ]
  }
